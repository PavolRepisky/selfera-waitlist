# Copy to .env.local (git-ignored) and fill in.
#
# Supabase dashboard → Project Settings → API — the Project URL and the
# anon / publishable key. Never put the service-role key here: everything
# prefixed VITE_ ends up in the page.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Where share links point. Defaults to the page's own address.
VITE_SITE_URL=

# PostHog → Project Settings → Project API key (public, safe in the page).
# Leave empty to run without analytics. Host defaults to the EU cloud; use
# https://us.i.posthog.com for a US project.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
